# Imagen de desarrollo para máquinas sin Rust ni stellar-cli (p. ej. Windows).
# Misma versión de Rust que rust-toolchain.toml y de stellar-cli que la CI.
# jq lo usan los scripts de testnet (deployments/*.json e informes).
FROM rust:1.98.1-slim-bookworm
ARG STELLAR_CLI_VERSION=28.1.0
RUN apt-get update -qq \
 && apt-get install -y -qq --no-install-recommends curl ca-certificates jq libdbus-1-3 libudev1 \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://github.com/stellar/stellar-cli/releases/download/v${STELLAR_CLI_VERSION}/stellar-cli-${STELLAR_CLI_VERSION}-x86_64-unknown-linux-gnu.tar.gz" \
    | tar -xz -C /usr/local/bin \
 && stellar --version
